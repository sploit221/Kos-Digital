<%- include('partials/head', { title: title || 'Terjadi Kesalahan', bodyClass: 'bg-slate-950 text-slate-800' }) %>
<main class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-12">
  <div class="absolute inset-0 hero-grid"></div>
  <div class="absolute -left-24 top-1/4 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
  <div class="absolute -right-24 bottom-1/4 h-72 w-72 rounded-full bg-teal-400/10 blur-3xl"></div>

  <div class="relative w-full max-w-lg rounded-[2rem] border border-white/60 bg-white p-8 text-center shadow-2xl sm:p-10">
    <a href="/" class="inline-flex"><%- include('partials/logo') %></a>

    <p class="mt-8 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-600">Error <%= status %></p>
    <h1 class="mt-2 text-7xl font-extrabold tracking-tighter text-slate-900"><%= status %></h1>
    <h2 class="mt-2 text-lg font-extrabold text-slate-800"><%= title %></h2>
    <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-slate-500"><%= message %></p>

    <div class="mt-8 flex flex-col justify-center gap-2.5 sm:flex-row">
      <a href="/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M3.5 10.4 12 3.5l8.5 6.9M5.5 9.4v9.1c0 .6.5 1.1 1.1 1.1h10.8c.6 0 1.1-.5 1.1-1.1V9.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Ke Beranda
      </a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="<%= currentUser.role === 'admin' ? '/admin' : '/penghuni' %>" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:border-brand-300 hover:text-brand-700">Buka Dashboard</a>
      <% } else { %>
        <a href="/login" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:border-brand-300 hover:text-brand-700">Masuk Akun</a>
      <% } %>
    </div>
  </div>
</main>
<%- include('partials/end') %>
