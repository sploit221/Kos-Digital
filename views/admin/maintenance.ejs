<%- include('../partials/head', { title: 'Laporan Maintenance', bodyClass: 'bg-slate-100 text-slate-800' }) %>
<div class="min-h-screen">
  <%- include('../partials/admin-sidebar') %>
  <div class="lg:pl-72">
    <%- include('../partials/dash-topbar', { title: 'Laporan Maintenance', subtitle: 'Tindak lanjuti laporan kerusakan dari penghuni.' }) %>

    <main class="space-y-6 p-4 sm:p-6 lg:p-8">
      <%- include('../partials/flash') %>

      <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Total Laporan</p>
          <p class="mt-1.5 text-2xl font-extrabold text-slate-900"><%= stats.total %></p>
        </div>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-amber-600">Pending</p>
          <p class="mt-1.5 text-2xl font-extrabold text-amber-800"><%= stats.pending %></p>
        </div>
        <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-sky-600">Diproses</p>
          <p class="mt-1.5 text-2xl font-extrabold text-sky-800"><%= stats.diproses %></p>
        </div>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-600">Selesai</p>
          <p class="mt-1.5 text-2xl font-extrabold text-emerald-800"><%= stats.selesai %></p>
        </div>
      </section>

      <div class="flex flex-wrap items-center gap-2">
        <a href="/admin/maintenance" class="inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs font-bold transition <%= status === 'all' ? 'bg-slate-900 text-white shadow-sm' : 'border border-slate-200 bg-white text-slate-600 hover:border-brand-300 hover:text-brand-700' %>">Semua <span class="rounded-full px-1.5 py-0.5 text-[9px] <%= status === 'all' ? 'bg-white/15 text-white' : 'bg-slate-100 text-slate-500' %>"><%= stats.total %></span></a>
        <a href="/admin/maintenance?status=pending" class="inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs font-bold transition <%= status === 'pending' ? 'bg-amber-500 text-white shadow-sm' : 'border border-slate-200 bg-white text-slate-600 hover:border-amber-300 hover:text-amber-700' %>">Pending <span class="rounded-full px-1.5 py-0.5 text-[9px] <%= status === 'pending' ? 'bg-white/20 text-white' : 'bg-amber-50 text-amber-600' %>"><%= stats.pending %></span></a>
        <a href="/admin/maintenance?status=diproses" class="inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs font-bold transition <%= status === 'diproses' ? 'bg-sky-500 text-white shadow-sm' : 'border border-slate-200 bg-white text-slate-600 hover:border-sky-300 hover:text-sky-700' %>">Diproses <span class="rounded-full px-1.5 py-0.5 text-[9px] <%= status === 'diproses' ? 'bg-white/20 text-white' : 'bg-sky-50 text-sky-600' %>"><%= stats.diproses %></span></a>
        <a href="/admin/maintenance?status=selesai" class="inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs font-bold transition <%= status === 'selesai' ? 'bg-emerald-500 text-white shadow-sm' : 'border border-slate-200 bg-white text-slate-600 hover:border-emerald-300 hover:text-emerald-700' %>">Selesai <span class="rounded-full px-1.5 py-0.5 text-[9px] <%= status === 'selesai' ? 'bg-white/20 text-white' : 'bg-emerald-50 text-emerald-600' %>"><%= stats.selesai %></span></a>
      </div>

      <% if (reports.length === 0) { %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
          <span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <p class="mt-4 text-sm font-semibold text-slate-600">Tidak ada laporan pada filter ini.</p>
          <p class="mt-1 text-xs text-slate-400">Laporan baru dari penghuni akan tampil di sini.</p>
        </div>
      <% } else { %>
        <section class="grid gap-4 xl:grid-cols-2">
          <% reports.forEach((report) => { %>
            <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl <%= report.status === 'selesai' ? 'bg-emerald-50 text-emerald-700' : report.status === 'diproses' ? 'bg-sky-50 text-sky-700' : 'bg-amber-50 text-amber-700' %>">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M14.5 6.5a4 4 0 0 0-5-5L7 4l3 3 2.5-2.5a4 4 0 0 0 2 2ZM9.5 7.5 3 14v4h4l6.5-6.5M13 20l7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-slate-500"><%= report.category %></span>
                      <span class="rounded-full px-2 py-0.5 text-[9px] font-bold <%= badgeClass(report.priority) %>"><%= priorityLabel(report.priority) %></span>
                    </div>
                    <h3 class="mt-1.5 text-sm font-extrabold text-slate-900"><%= report.title %></h3>
                    <p class="mt-0.5 text-[11px] text-slate-500"><%= report.resident_name %> &middot; Kamar <%= report.room_number || '-' %> &middot; <%= formatDateTime(report.created_at) %></p>
                  </div>
                </div>
                <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-bold <%= badgeClass(report.status) %>"><%= statusLabel(report.status) %></span>
              </div>

              <p class="mt-4 rounded-xl bg-slate-50 p-3 text-xs leading-relaxed text-slate-600"><%= report.description %></p>

              <% if (report.admin_note) { %>
                <div class="mt-3 rounded-xl border border-brand-100 bg-brand-50/60 p-3">
                  <p class="text-[9px] font-bold uppercase tracking-wider text-brand-700">Catatan Admin</p>
                  <p class="mt-1 text-xs text-brand-900"><%= report.admin_note %></p>
                </div>
              <% } %>

              <form action="/admin/maintenance/<%= report.id %>/status" method="post" class="mt-4 space-y-2.5 border-t border-slate-100 pt-4">
                <input type="hidden" name="back_status" value="<%= status %>">
                <div class="grid grid-cols-[140px_1fr] gap-2">
                  <div>
                    <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Status</label>
                    <select name="status" class="w-full rounded-lg border-slate-200 bg-slate-50 px-2.5 py-2 text-xs font-semibold focus:border-brand-500 focus:bg-white focus:ring-brand-500">
                      <option value="pending" <%= report.status === 'pending' ? 'selected' : '' %>>Pending</option>
                      <option value="diproses" <%= report.status === 'diproses' ? 'selected' : '' %>>Diproses</option>
                      <option value="selesai" <%= report.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
                    </select>
                  </div>
                  <div>
                    <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Catatan Admin</label>
                    <input name="admin_note" value="<%= report.admin_note || '' %>" maxlength="1000" placeholder="Tambahkan catatan penanganan..." class="w-full rounded-lg border-slate-200 bg-slate-50 px-2.5 py-2 text-xs focus:border-brand-500 focus:bg-white focus:ring-brand-500">
                  </div>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-[10px] text-slate-400">#<%= String(report.id).padStart(4, '0') %> &middot; <%= report.phone || 'Tanpa telepon' %></p>
                  <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-[10px] font-bold text-white transition hover:bg-slate-800">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Simpan
                  </button>
                </div>
              </form>
            </article>
          <% }); %>
        </section>
      <% } %>
    </main>
  </div>
</div>
<%- include('../partials/end') %>
