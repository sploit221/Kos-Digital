<%- include('../partials/head', { title: 'Laporan Warga ke RT', bodyClass: 'bg-slate-100 text-slate-800' }) %>
<div class="min-h-screen">
  <%- include('../partials/admin-sidebar') %>
  <div class="lg:pl-72">
    <%- include('../partials/dash-topbar', { title: 'Laporan Warga ke RT', subtitle: 'Ekspor data penghuni baru dan simulasikan pengiriman ke pihak RT.' }) %>

    <main class="space-y-6 p-4 sm:p-6 lg:p-8">
      <%- include('../partials/flash') %>

      <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-600 via-emerald-600 to-teal-700 p-6 text-white shadow-glow sm:p-8">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
        <div class="absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-emerald-300/20 blur-2xl"></div>
        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-100">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7V3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v4h4M10 12h5M10 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              Administrasi Kependudukan
            </span>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">Laporan Warga Baru</h2>
            <p class="mt-2 max-w-xl text-sm text-emerald-50/90">Data penghuni baru periode <b><%= data.month_label %></b> siap dilaporkan ke pihak RT. Gunakan tombol kirim untuk menjalankan simulasi integrasi API.</p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <form action="/admin/reports/rt" method="get" class="flex items-center gap-2 rounded-xl bg-white/10 p-1 ring-1 ring-inset ring-white/20 backdrop-blur">
              <input type="month" name="month" value="<%= data.month %>" class="rounded-lg border-0 bg-white/95 px-2.5 py-1.5 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-white/60">
              <button type="submit" class="rounded-lg bg-white/15 px-3 py-1.5 text-[11px] font-bold text-white transition hover:bg-white/25">Tampilkan</button>
            </form>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Warga Baru Periode Ini</p>
          <p class="mt-1.5 text-2xl font-extrabold text-slate-900"><%= data.total %><span class="ml-1 text-xs font-semibold text-slate-400">orang</span></p>
        </div>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-amber-600">Belum Dilaporkan</p>
          <p data-unreported class="mt-1.5 text-2xl font-extrabold text-amber-800"><%= data.unreported %><span class="ml-1 text-xs font-semibold text-amber-600">orang</span></p>
        </div>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-600">Sudah Dilaporkan</p>
          <p data-reported class="mt-1.5 text-2xl font-extrabold text-emerald-800"><%= data.total - data.unreported %><span class="ml-1 text-xs font-semibold text-emerald-600">orang</span></p>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 lg:col-span-2">
          <h2 class="text-base font-extrabold text-slate-900">Aksi Laporan</h2>
          <p class="mt-0.5 text-xs text-slate-500">Kirim melalui simulasi API atau unduh berkas laporan resmi.</p>

          <div class="mt-5 flex flex-wrap gap-2.5">
            <button id="sendRtReport" type="button" data-month="<%= data.month %>" data-total="<%= data.total %>" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-3 text-xs font-bold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-400 disabled:shadow-none">
              <svg data-send-icon class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="m4 4 17 8-17 8 3-8-3-8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M7 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              <span data-send-label>Kirim Laporan ke RT</span>
            </button>
            <a href="/admin/reports/rt/print?month=<%= data.month %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs font-bold text-slate-700 transition hover:border-brand-300 hover:text-brand-700">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M7 9V3h10v6M7 17H4V9h16v8h-3M7 14h10v7H7v-7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
              Cetak
            </a>
            <a href="/admin/reports/rt/pdf?month=<%= data.month %>" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs font-bold text-slate-700 transition hover:border-brand-300 hover:text-brand-700">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7V3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v4h4M10 13h4M10 17h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              Unduh PDF
            </a>
            <a href="/admin/reports/rt/download?month=<%= data.month %>" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs font-bold text-slate-700 transition hover:border-brand-300 hover:text-brand-700">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Unduh Teks
            </a>
          </div>

          <div id="rtResult" class="mt-4 hidden rounded-2xl border p-4 text-xs"></div>

          <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-start gap-3">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white text-slate-500 ring-1 ring-slate-200"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 8v4m0 4h.01M10.3 3.9 2.4 17.4A1.9 1.9 0 0 0 4 20.3h16a1.9 1.9 0 0 0 1.6-2.9L13.7 3.9a1.9 1.9 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <div>
                <p class="text-xs font-bold text-slate-700">Mode Simulasi</p>
                <p class="mt-0.5 text-[11px] leading-relaxed text-slate-500">Pengiriman dilakukan ke endpoint mock <code class="rounded bg-white px-1.5 py-0.5 text-slate-600">mock://rt-batam-center/v1/residents</code>. Data yang dikirim: nama, NIK, nomor kamar, asal, telepon, dan tanggal masuk. Status laporan akan diperbarui setelah pengiriman.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <h2 class="text-base font-extrabold text-slate-900">Riwayat Pengiriman</h2>
          <% if (lastReport) { %>
            <div class="mt-4 rounded-2xl bg-slate-950 p-4 text-white">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-2 rounded-full bg-emerald-500/15 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span><%= lastReport.status %></span>
                <span class="text-[10px] text-slate-400"><%= formatDateTime(lastReport.sent_at) %></span>
              </div>
              <p class="mt-3 text-lg font-extrabold"><%= lastReport.month_label %></p>
              <p class="text-[11px] text-slate-400"><%= lastReport.total %> warga &middot; Ref. <%= lastReport.reference %></p>
              <p class="mt-3 truncate rounded-lg bg-white/5 px-2.5 py-2 font-mono text-[9px] text-slate-400"><%= lastReport.endpoint %></p>
            </div>
          <% } else { %>
            <div class="mt-4 rounded-2xl border border-dashed border-slate-300 p-5 text-center">
              <span class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="m4 4 17 8-17 8 3-8-3-8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
              <p class="mt-3 text-xs font-semibold text-slate-600">Belum ada riwayat pengiriman.</p>
              <p class="mt-1 text-[11px] text-slate-400">Riwayat akan muncul setelah laporan dikirim.</p>
            </div>
          <% } %>

          <div class="mt-4 rounded-xl bg-brand-50 p-3.5">
            <p class="text-[10px] font-bold uppercase tracking-wider text-brand-700">Periode Tersedia</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <% monthOptions.slice(0, 6).forEach((month) => { %>
                <a href="/admin/reports/rt?month=<%= month %>" class="rounded-lg px-2.5 py-1 text-[10px] font-bold <%= month === data.month ? 'bg-brand-600 text-white' : 'bg-white text-brand-700 ring-1 ring-brand-600/10 hover:bg-brand-100' %>"><%= formatMonth(month) %></a>
              <% }); %>
              <% if (monthOptions.length === 0) { %><span class="text-[10px] text-brand-700">Belum ada data.</span><% } %>
            </div>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5 sm:p-6">
          <div>
            <h2 class="text-base font-extrabold text-slate-900">Data Warga Baru — <%= data.month_label %></h2>
            <p class="mt-0.5 text-xs text-slate-500">Data diambil dari pendaftaran penghuni pada periode terpilih.</p>
          </div>
          <span class="inline-flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-2 text-[11px] font-bold text-slate-500 ring-1 ring-inset ring-slate-200">Dibuat <%= formatDateTime(data.generated_at) %></span>
        </div>

        <% if (data.residents.length === 0) { %>
          <div class="p-10 text-center">
            <p class="text-sm font-semibold text-slate-600">Belum ada penghuni baru pada periode ini.</p>
            <p class="mt-1 text-xs text-slate-400">Pilih periode lain atau daftarkan penghuni baru terlebih dahulu.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[820px] text-left text-sm">
              <thead class="bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                <tr>
                  <th class="px-5 py-3 sm:px-6">No</th>
                  <th class="px-5 py-3">Nama Lengkap</th>
                  <th class="px-5 py-3">NIK</th>
                  <th class="px-5 py-3">Kamar</th>
                  <th class="px-5 py-3">Asal</th>
                  <th class="px-5 py-3">Tanggal Masuk</th>
                  <th class="px-5 py-3 text-right sm:px-6">Status RT</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% data.residents.forEach((resident, index) => { %>
                  <tr class="transition hover:bg-slate-50/70">
                    <td class="px-5 py-3.5 text-xs font-bold text-slate-400 sm:px-6"><%= String(index + 1).padStart(2, '0') %></td>
                    <td class="px-5 py-3.5">
                      <div class="flex items-center gap-2.5">
                        <div class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-emerald-400 to-teal-600 text-[10px] font-extrabold text-white"><%= initials(resident.name) %></div>
                        <span class="text-xs font-bold text-slate-800"><%= resident.name %></span>
                      </div>
                    </td>
                    <td class="whitespace-nowrap px-5 py-3.5 font-mono text-[11px] text-slate-600"><%= resident.nik || '-' %></td>
                    <td class="px-5 py-3.5"><span class="rounded-lg bg-slate-900 px-2 py-1 text-[10px] font-bold text-white"><%= resident.room_number || '-' %></span></td>
                    <td class="px-5 py-3.5 text-xs text-slate-600"><%= resident.origin || '-' %></td>
                    <td class="whitespace-nowrap px-5 py-3.5 text-xs text-slate-600"><%= formatDate(resident.created_at) %></td>
                    <td class="px-5 py-3.5 text-right sm:px-6">
                      <% if (resident.reported_to_rt_at) { %>
                        <span data-rt-badge class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Terkirim</span>
                      <% } else { %>
                        <span data-rt-badge class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold text-amber-700 ring-1 ring-inset ring-amber-600/20">Belum</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/end') %>
