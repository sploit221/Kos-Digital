<%- include('../partials/head', { title: 'Dashboard Admin', bodyClass: 'bg-slate-100 text-slate-800' }) %>
<div class="min-h-screen">
  <%- include('../partials/admin-sidebar') %>
  <div class="lg:pl-72">
    <%- include('../partials/dash-topbar', { title: 'Dashboard', subtitle: greeting() + ', ' + currentUser.name + '. Berikut ringkasan kos hari ini.' }) %>

    <main data-admin-dashboard class="space-y-6 p-4 sm:p-6 lg:p-8">
      <%- include('../partials/flash') %>

      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Total Kamar</p>
              <p class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900" data-admin-stat="totalRooms"><%= roomStats.total %></p>
              <p class="mt-1 text-[11px] font-medium text-slate-500">Kapasitas terdaftar</p>
            </div>
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-slate-100 text-slate-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M4 21V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16M4 21h16M9 21v-5h6v5M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
          <div class="mt-4 flex items-center gap-3 text-[11px] font-semibold">
            <span class="inline-flex items-center gap-1.5 text-emerald-600"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><%= roomStats.kosong %> kosong</span>
            <span class="inline-flex items-center gap-1.5 text-sky-600"><span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span><%= roomStats.terisi %> terisi</span>
            <span class="inline-flex items-center gap-1.5 text-amber-600"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span><%= roomStats.maintenance %> servis</span>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Tingkat Hunian</p>
              <p class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900"><span data-admin-stat="occupancy"><%= occupancy %></span><span class="text-lg text-slate-400">%</span></p>
              <p class="mt-1 text-[11px] font-medium text-slate-500"><%= roomStats.terisi %> dari <%= roomStats.total %> kamar terisi</p>
            </div>
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M4 19V9m5 10V5m5 14v-7m5 7V3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </span>
          </div>
          <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100">
            <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-teal-500" style="width: <%= occupancy %>%"></div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Penghuni Aktif</p>
              <p class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900" data-admin-stat="residentCount"><%= residentCount %></p>
              <p class="mt-1 text-[11px] font-medium text-slate-500">Terdaftar &amp; aktif</p>
            </div>
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-sky-50 text-sky-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M16 19c0-2.2-1.8-4-4-4H7c-2.2 0-4 1.8-4 4M9.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM17 11a3 3 0 1 0 0-6M21 19c0-1.8-1-3.3-2.5-3.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </span>
          </div>
          <a href="/admin/residents" class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-bold text-brand-700 hover:text-brand-800">Lihat data penghuni <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Maintenance Aktif</p>
              <p class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900" data-admin-stat="maintenanceActive"><%= maintenance.pending + maintenance.diproses %></p>
              <p class="mt-1 text-[11px] font-medium text-slate-500" data-admin-stat="maintenanceDetail"><%= maintenance.pending %> pending &middot; <%= maintenance.diproses %> diproses</p>
            </div>
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-amber-50 text-amber-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M14.5 6.5a4 4 0 0 0-5-5L7 4l3 3 2.5-2.5a4 4 0 0 0 2 2ZM9.5 7.5 3 14v4h4l6.5-6.5M13 20l7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
          <a href="/admin/maintenance" class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-bold text-brand-700 hover:text-brand-800">Kelola laporan <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Ringkasan Kamar</h2>
              <p class="mt-0.5 text-xs text-slate-500">Distribusi status kamar secara langsung.</p>
            </div>
            <a href="/admin/rooms" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">Kelola kamar</a>
          </div>

          <div class="mt-5 space-y-4">
            <div>
              <div class="flex items-center justify-between text-xs font-semibold">
                <span class="inline-flex items-center gap-2 text-slate-600"><span class="h-2 w-2 rounded-full bg-sky-500"></span>Terisi</span>
                <span class="text-slate-800"><span data-admin-stat="roomsTerisi"><%= roomStats.terisi %></span> kamar</span>
              </div>
              <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-sky-500" data-admin-bar="terisi" style="width: <%= roomStats.total ? (roomStats.terisi / roomStats.total) * 100 : 0 %>%"></div></div>
            </div>
            <div>
              <div class="flex items-center justify-between text-xs font-semibold">
                <span class="inline-flex items-center gap-2 text-slate-600"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Kosong</span>
                <span class="text-slate-800"><span data-admin-stat="roomsKosong"><%= roomStats.kosong %></span> kamar</span>
              </div>
              <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-emerald-500" data-admin-bar="kosong" style="width: <%= roomStats.total ? (roomStats.kosong / roomStats.total) * 100 : 0 %>%"></div></div>
            </div>
            <div>
              <div class="flex items-center justify-between text-xs font-semibold">
                <span class="inline-flex items-center gap-2 text-slate-600"><span class="h-2 w-2 rounded-full bg-amber-500"></span>Maintenance</span>
                <span class="text-slate-800"><span data-admin-stat="roomsMaintenance"><%= roomStats.maintenance %></span> kamar</span>
              </div>
              <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-amber-500" data-admin-bar="maintenance" style="width: <%= roomStats.total ? (roomStats.maintenance / roomStats.total) * 100 : 0 %>%"></div></div>
            </div>
          </div>

          <div class="mt-6 grid gap-3 sm:grid-cols-3">
            <a href="/admin/rooms" class="group rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:border-brand-300 hover:bg-white">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-white text-brand-700 shadow-sm ring-1 ring-slate-200 group-hover:bg-brand-600 group-hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></span>
              <p class="mt-2.5 text-xs font-extrabold text-slate-800">Tambah Kamar</p>
            </a>
            <a href="/admin/residents" class="group rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:border-brand-300 hover:bg-white">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-white text-brand-700 shadow-sm ring-1 ring-slate-200 group-hover:bg-brand-600 group-hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M16 19c0-2.2-1.8-4-4-4H7c-2.2 0-4 1.8-4 4M9.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM18 8v6m-3-3h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
              <p class="mt-2.5 text-xs font-extrabold text-slate-800">Daftarkan Penghuni</p>
            </a>
            <a href="/admin/reports/rt" class="group rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:border-brand-300 hover:bg-white">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-white text-brand-700 shadow-sm ring-1 ring-slate-200 group-hover:bg-brand-600 group-hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7V3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v4h4M10 12h5M10 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
              <p class="mt-2.5 text-xs font-extrabold text-slate-800">Laporan RT</p>
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 to-slate-950 p-5 text-white shadow-soft sm:p-6">
            <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-emerald-500/20 blur-2xl"></div>
            <div class="relative">
              <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.16em] text-emerald-300">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-soft"></span> Administrasi RT
              </span>
              <h2 class="mt-3 text-lg font-extrabold">Laporan Warga Baru</h2>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-400">Ada <b class="text-white" data-admin-stat="rtPending"><%= rtPending %></b> penghuni baru bulan ini yang belum dilaporkan ke RT.</p>
              <a href="/admin/reports/rt" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-bold text-white transition hover:bg-emerald-400">
                Buat Laporan
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-extrabold text-slate-900">Penghuni Terbaru</h2>
              <a href="/admin/residents" class="text-[11px] font-bold text-brand-700">Semua</a>
            </div>
            <div class="mt-4 space-y-3">
              <% if (recentResidents.length === 0) { %>
                <p class="rounded-xl bg-slate-50 p-4 text-xs text-slate-500">Belum ada penghuni terdaftar.</p>
              <% } %>
              <% recentResidents.forEach((resident) => { %>
                <div class="flex items-center gap-3">
                  <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 text-[10px] font-extrabold text-white"><%= initials(resident.name) %></div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-xs font-bold text-slate-800"><%= resident.name %></p>
                    <p class="text-[10px] text-slate-400">Kamar <%= resident.room_number || '-' %> &middot; <%= resident.origin || '-' %></p>
                  </div>
                  <% if (resident.reported_to_rt_at) { %>
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[9px] font-bold text-emerald-700">RT</span>
                  <% } else { %>
                    <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[9px] font-bold text-amber-700">Baru</span>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5 sm:p-6">
          <div>
            <h2 class="text-base font-extrabold text-slate-900">Laporan Maintenance Terbaru</h2>
            <p class="mt-0.5 text-xs text-slate-500">Pantau laporan kerusakan dari penghuni.</p>
          </div>
          <a href="/admin/maintenance" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">Lihat semua</a>
        </div>

        <% if (recentMaintenance.length === 0) { %>
          <div class="p-8 text-center">
            <p class="text-sm font-semibold text-slate-600">Belum ada laporan maintenance.</p>
            <p class="mt-1 text-xs text-slate-400">Laporan dari penghuni akan muncul di sini.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] text-left text-sm">
              <thead class="bg-slate-50 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                <tr>
                  <th class="px-5 py-3 sm:px-6">Penghuni</th>
                  <th class="px-5 py-3">Masalah</th>
                  <th class="px-5 py-3">Prioritas</th>
                  <th class="px-5 py-3">Status</th>
                  <th class="px-5 py-3">Tanggal</th>
                  <th class="px-5 py-3 text-right sm:px-6">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% recentMaintenance.forEach((report) => { %>
                  <tr class="transition hover:bg-slate-50/70">
                    <td class="px-5 py-3.5 sm:px-6">
                      <div class="flex items-center gap-3">
                        <div class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-slate-100 text-[10px] font-extrabold text-slate-600"><%= initials(report.resident_name) %></div>
                        <div>
                          <p class="text-xs font-bold text-slate-800"><%= report.resident_name %></p>
                          <p class="text-[10px] text-slate-400">Kamar <%= report.room_number || '-' %></p>
                        </div>
                      </div>
                    </td>
                    <td class="max-w-[260px] px-5 py-3.5">
                      <p class="truncate text-xs font-semibold text-slate-800"><%= report.title %></p>
                      <p class="text-[10px] text-slate-400"><%= report.category %></p>
                    </td>
                    <td class="px-5 py-3.5"><span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-bold <%= badgeClass(report.priority) %>"><%= priorityLabel(report.priority) %></span></td>
                    <td class="px-5 py-3.5"><span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-bold <%= badgeClass(report.status) %>"><%= statusLabel(report.status) %></span></td>
                    <td class="whitespace-nowrap px-5 py-3.5 text-[11px] text-slate-500"><%= formatDateTime(report.created_at) %></td>
                    <td class="px-5 py-3.5 text-right sm:px-6"><a href="/admin/maintenance?status=<%= report.status %>" class="inline-flex rounded-lg border border-slate-200 px-2.5 py-1.5 text-[10px] font-bold text-slate-600 hover:border-brand-300 hover:text-brand-700">Tangani</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/end') %>
