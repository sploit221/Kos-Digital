<%- include('../partials/head', { title: 'Manajemen Kamar', bodyClass: 'bg-slate-100 text-slate-800' }) %>
<div class="min-h-screen">
  <%- include('../partials/admin-sidebar') %>
  <div class="lg:pl-72">
    <%- include('../partials/dash-topbar', { title: 'Manajemen Kamar', subtitle: 'Tambah kamar, atur harga, dan pantau status hunian.' }) %>

    <main class="space-y-6 p-4 sm:p-6 lg:p-8">
      <%- include('../partials/flash') %>

      <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Total</p>
          <p class="mt-1.5 text-2xl font-extrabold text-slate-900"><%= stats.total %></p>
        </div>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-600">Kosong</p>
          <p class="mt-1.5 text-2xl font-extrabold text-emerald-800"><%= stats.kosong %></p>
        </div>
        <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-sky-600">Terisi</p>
          <p class="mt-1.5 text-2xl font-extrabold text-sky-800"><%= stats.terisi %></p>
        </div>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-amber-600">Maintenance</p>
          <p class="mt-1.5 text-2xl font-extrabold text-amber-800"><%= stats.maintenance %></p>
        </div>
      </section>

      <section class="grid gap-6 xl:grid-cols-[380px_1fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:sticky xl:top-24 xl:self-start sm:p-6">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
            </span>
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Tambah Kamar</h2>
              <p class="text-xs text-slate-500">Kamar baru berstatus kosong atau maintenance.</p>
            </div>
          </div>

          <form action="/admin/rooms" method="post" class="mt-5 space-y-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="room_number" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Nomor Kamar *</label>
                <input id="room_number" name="room_number" required maxlength="12" placeholder="113" class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold focus:border-brand-500 focus:bg-white focus:ring-brand-500">
              </div>
              <div>
                <label for="floor" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Lantai *</label>
                <input id="floor" name="floor" type="number" min="1" max="50" value="1" required class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold focus:border-brand-500 focus:bg-white focus:ring-brand-500">
              </div>
            </div>
            <div>
              <label for="room_type" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Tipe Kamar *</label>
              <input id="room_type" name="room_type" required maxlength="40" value="Standard" placeholder="Standard / Deluxe / Premium" class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold focus:border-brand-500 focus:bg-white focus:ring-brand-500">
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="monthly_price" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Harga / Bulan *</label>
                <input id="monthly_price" name="monthly_price" type="number" min="0" step="1000" value="850000" required class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold focus:border-brand-500 focus:bg-white focus:ring-brand-500">
              </div>
              <div>
                <label for="status" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Status</label>
                <select id="status" name="status" class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold focus:border-brand-500 focus:bg-white focus:ring-brand-500">
                  <option value="kosong">Kosong</option>
                  <option value="maintenance">Maintenance</option>
                </select>
              </div>
            </div>
            <div>
              <label for="notes" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Catatan</label>
              <textarea id="notes" name="notes" rows="2" maxlength="300" placeholder="Opsional, misal: dekat balkon" class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-brand-500"></textarea>
            </div>
            <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
              Simpan Kamar
            </button>
          </form>
        </div>

        <div class="min-w-0">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Daftar Kamar</h2>
              <p class="text-xs text-slate-500"><%= stats.total %> kamar terdaftar. Klik "Kelola" untuk mengubah data.</p>
            </div>
            <div class="relative w-full sm:w-64">
              <span class="pointer-events-none absolute inset-y-0 left-0 grid w-10 place-items-center text-slate-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </span>
              <input type="search" data-room-search placeholder="Cari nomor / tipe / penghuni" class="w-full rounded-xl border-slate-200 bg-white py-2.5 pl-10 pr-3 text-xs font-semibold shadow-sm focus:border-brand-500 focus:ring-brand-500">
            </div>
          </div>

          <% if (rooms.length === 0) { %>
            <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
              <p class="text-sm font-semibold text-slate-600">Belum ada data kamar.</p>
              <p class="mt-1 text-xs text-slate-400">Tambahkan kamar pertama melalui formulir di samping.</p>
            </div>
          <% } else { %>
          <div data-room-grid class="mt-4 grid gap-4 md:grid-cols-2">
            <% rooms.forEach((room) => { %>
              <article data-room-card data-search="<%= (room.room_number + ' ' + room.room_type + ' ' + (room.occupant_name || '')).toLowerCase() %>" class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <div class="grid h-12 w-12 place-items-center rounded-xl bg-slate-900 text-sm font-extrabold text-white"><%= room.room_number %></div>
                    <div>
                      <h3 class="text-sm font-extrabold text-slate-900"><%= room.room_type %></h3>
                      <p class="text-[11px] text-slate-500">Lantai <%= room.floor %> &middot; <%= formatRupiah(room.monthly_price) %>/bln</p>
                    </div>
                  </div>
                  <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-bold <%= badgeClass(room.status) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= room.status === 'kosong' ? 'bg-emerald-500' : room.status === 'terisi' ? 'bg-sky-500' : 'bg-amber-500' %>"></span>
                    <%= roomStatusLabel(room.status) %>
                  </span>
                </div>

                <div class="mt-4 rounded-xl bg-slate-50 px-3 py-2.5">
                  <% if (room.occupant_name) { %>
                    <div class="flex items-center gap-2.5">
                      <div class="grid h-7 w-7 place-items-center rounded-lg bg-white text-[9px] font-extrabold text-slate-600 ring-1 ring-slate-200"><%= initials(room.occupant_name) %></div>
                      <p class="text-[11px] font-semibold text-slate-700"><%= room.occupant_name %></p>
                      <a href="/admin/residents?q=<%= room.room_number %>" class="ml-auto text-[10px] font-bold text-brand-700">Detail</a>
                    </div>
                  <% } else { %>
                    <p class="text-[11px] font-medium text-slate-400"><%= room.status === 'maintenance' ? 'Kamar sedang dalam perbaikan.' : 'Belum ada penghuni.' %></p>
                  <% } %>
                </div>

                <% if (room.notes) { %>
                  <p class="mt-2 line-clamp-1 text-[10px] text-slate-400"><%= room.notes %></p>
                <% } %>

                <details class="group/details mt-3">
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl border border-slate-200 px-3 py-2 text-[11px] font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">
                    Kelola Kamar
                    <svg class="h-3.5 w-3.5 transition group-open/details:rotate-180" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </summary>

                  <form action="/admin/rooms/<%= room.id %>/update" method="post" class="mt-3 space-y-3 rounded-xl border border-slate-100 bg-slate-50/70 p-3">
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Tipe</label>
                        <input name="room_type" value="<%= room.room_type %>" maxlength="40" required class="w-full rounded-lg border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold focus:border-brand-500 focus:ring-brand-500">
                      </div>
                      <div>
                        <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Lantai</label>
                        <input name="floor" type="number" min="1" max="50" value="<%= room.floor %>" required class="w-full rounded-lg border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold focus:border-brand-500 focus:ring-brand-500">
                      </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Harga</label>
                        <input name="monthly_price" type="number" min="0" step="1000" value="<%= room.monthly_price %>" required class="w-full rounded-lg border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold focus:border-brand-500 focus:ring-brand-500">
                      </div>
                      <div>
                        <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Status</label>
                        <% if (room.occupant_id) { %>
                          <input type="hidden" name="status" value="terisi">
                          <div class="flex h-[34px] items-center rounded-lg border border-slate-200 bg-slate-100 px-2.5 text-xs font-semibold text-slate-500">Terisi (terkunci)</div>
                        <% } else { %>
                          <select name="status" class="w-full rounded-lg border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold focus:border-brand-500 focus:ring-brand-500">
                            <option value="kosong" <%= room.status === 'kosong' ? 'selected' : '' %>>Kosong</option>
                            <option value="maintenance" <%= room.status === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                          </select>
                        <% } %>
                      </div>
                    </div>
                    <div>
                      <label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">Catatan</label>
                      <input name="notes" value="<%= room.notes || '' %>" maxlength="300" placeholder="Catatan kamar" class="w-full rounded-lg border-slate-200 bg-white px-2.5 py-2 text-xs focus:border-brand-500 focus:ring-brand-500">
                    </div>
                    <div class="flex gap-2">
                      <button type="submit" class="flex-1 rounded-lg bg-slate-900 px-3 py-2 text-[11px] font-bold text-white transition hover:bg-slate-800">Simpan Perubahan</button>
                      <% if (!room.occupant_id) { %>
                        <button type="submit" formaction="/admin/rooms/<%= room.id %>/delete" formmethod="post" data-confirm="Hapus kamar <%= room.room_number %>? Tindakan ini tidak dapat dibatalkan." class="rounded-lg border border-rose-200 bg-white px-3 py-2 text-[11px] font-bold text-rose-600 transition hover:bg-rose-50">Hapus</button>
                      <% } %>
                    </div>
                  </form>
                </details>
              </article>
            <% }); %>
          </div>

          <div data-room-empty class="mt-4 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center">
            <p class="text-sm font-semibold text-slate-600">Kamar tidak ditemukan.</p>
            <p class="mt-1 text-xs text-slate-400">Coba kata kunci lain.</p>
          </div>
          <% } %>
        </div>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/end') %>
