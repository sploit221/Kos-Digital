<%- include('../partials/head', { title: 'Peraturan & Fasilitas', bodyClass: 'bg-slate-100 text-slate-800' }) %>
<%
const contactNumber = settings.kos_profile.whatsapp || settings.kos_profile.phone || '';
const waNumber = String(contactNumber).replace(/\D/g, '');
%>
<div class="min-h-screen">
  <%- include('../partials/penghuni-sidebar') %>
  <div class="lg:pl-72">
    <%- include('../partials/dash-topbar', { title: 'Peraturan & Fasilitas', subtitle: 'Informasi resmi seputar tata tertib, fasilitas, keamanan, dan lokasi kos.' }) %>

    <main class="space-y-6 p-4 sm:p-6 lg:p-8">
      <%- include('../partials/flash') %>

      <section class="relative overflow-hidden rounded-2xl bg-slate-950 p-6 text-white shadow-soft sm:p-8">
        <div class="absolute inset-0 hero-grid"></div>
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-emerald-500/20 blur-2xl"></div>
        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-300">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Tata Tertib Resmi
            </span>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">Kenyamanan bersama adalah tanggung jawab kita.</h2>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate-400">Mohon membaca dan mematuhi seluruh peraturan yang berlaku. Pelanggaran dapat dikenakan sanksi sesuai ketentuan pengelola.</p>
          </div>
          <div class="grid w-full max-w-sm grid-cols-2 gap-2.5">
            <div class="rounded-xl bg-white/5 p-3 ring-1 ring-inset ring-white/10">
              <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Jam Tamu</p>
              <p class="mt-1 text-xs font-extrabold"><%= settings.rules_note.visitor_hours %></p>
            </div>
            <div class="rounded-xl bg-white/5 p-3 ring-1 ring-inset ring-white/10">
              <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Jam Malam</p>
              <p class="mt-1 text-xs font-extrabold"><%= settings.rules_note.curfew %></p>
            </div>
            <div class="col-span-2 rounded-xl bg-emerald-500/10 p-3 ring-1 ring-inset ring-emerald-400/20">
              <p class="text-[9px] font-bold uppercase tracking-wider text-emerald-300">Kontak Pengelola</p>
              <p class="mt-1 text-xs font-extrabold"><%= contactNumber || 'Belum diatur' %></p>
            </div>
          </div>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 lg:col-span-2">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-amber-50 text-amber-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M6 3h9l4 4v14H6V3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M15 3v4h4M9 12h7M9 16h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
            <div><h2 class="text-base font-extrabold text-slate-900">Peraturan &amp; Tata Tertib</h2><p class="text-xs text-slate-500"><%= settings.rules.length %> ketentuan resmi yang berlaku di kos.</p></div>
          </div>
          <div class="mt-5 space-y-3">
            <% settings.rules.forEach((rule, index) => { %>
              <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50/60 p-4">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-white text-xs font-extrabold text-brand-700 shadow-sm ring-1 ring-slate-200"><%= String(index + 1).padStart(2, '0') %></span>
                <div>
                  <h3 class="text-sm font-extrabold text-slate-900"><%= rule.title %></h3>
                  <p class="mt-1 text-xs leading-relaxed text-slate-500"><%= rule.description %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="rounded-2xl border border-rose-100 bg-rose-50 p-5">
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-rose-600">Ketentuan Denda</p>
            <div class="mt-3 space-y-3">
              <div>
                <p class="text-[10px] font-semibold text-rose-500">Keterlambatan Sewa</p>
                <p class="text-sm font-extrabold text-rose-900"><%= settings.rules_note.late_penalty %></p>
              </div>
              <div class="border-t border-rose-100 pt-3">
                <p class="text-[10px] font-semibold text-rose-500">Kerusakan Fasilitas</p>
                <p class="text-sm font-extrabold text-rose-900"><%= settings.rules_note.damage_penalty %></p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Butuh Bantuan?</p>
            <p class="mt-2 text-sm font-extrabold text-slate-900"><%= settings.kos_profile.manager || 'Pengelola Kos' %></p>
            <p class="mt-1 text-xs text-slate-500"><%= contactNumber || 'Nomor kontak belum diatur oleh pengelola.' %></p>
            <% if (waNumber) { %>
              <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-bold text-white transition hover:bg-brand-700">Hubungi via WhatsApp</a>
            <% } else { %>
              <span class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-500">WhatsApp belum diatur</span>
            <% } %>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Cara Melapor</p>
            <ol class="mt-3 space-y-2.5 text-xs text-slate-600">
              <li class="flex gap-2"><span class="font-extrabold text-brand-600">1.</span> Buka menu Lapor Kerusakan.</li>
              <li class="flex gap-2"><span class="font-extrabold text-brand-600">2.</span> Pilih kategori dan prioritas.</li>
              <li class="flex gap-2"><span class="font-extrabold text-brand-600">3.</span> Jelaskan kerusakan secara detail.</li>
              <li class="flex gap-2"><span class="font-extrabold text-brand-600">4.</span> Pantau status hingga selesai.</li>
            </ol>
            <a href="/penghuni/maintenance" class="mt-4 inline-flex w-full items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">Buat Laporan</a>
          </div>
        </aside>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-50 text-emerald-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3ZM6 12V6a2 2 0 0 1 2-2h1M12 12V5.5a2 2 0 0 1 2-2h1M7 19l-1 2M17 19l1 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div><h2 class="text-base font-extrabold text-slate-900">Fasilitas Kos</h2><p class="text-xs text-slate-500"><%= settings.facilities.length %> fasilitas tersedia untuk seluruh penghuni.</p></div>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <% settings.facilities.forEach((facility) => { %>
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
              <div class="flex items-center gap-2">
                <span class="grid h-7 w-7 place-items-center rounded-lg bg-white text-brand-600 ring-1 ring-slate-200"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <h3 class="text-xs font-extrabold text-slate-800"><%= facility.name %></h3>
              </div>
              <p class="mt-2 text-[11px] leading-relaxed text-slate-500"><%= facility.description || 'Tersedia untuk penghuni.' %></p>
            </div>
          <% }); %>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-slate-900 text-emerald-300"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 3 4.5 6v5.5c0 4.4 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5.1 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <div><h2 class="text-base font-extrabold text-slate-900">Keamanan Lingkungan</h2><p class="text-xs text-slate-500"><%= settings.security.notes %></p></div>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-slate-50 p-3.5">
              <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">CCTV</p>
              <p class="mt-1 text-sm font-extrabold text-slate-800"><%= settings.security.cctv_count || 0 %> titik</p>
              <p class="text-[10px] font-semibold <%= settings.security.cctv_active ? 'text-emerald-600' : 'text-amber-600' %>"><%= settings.security.cctv_active ? 'Aktif 24 jam' : 'Dalam perawatan' %></p>
            </div>
            <div class="rounded-xl bg-slate-50 p-3.5">
              <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Fingerprint</p>
              <p class="mt-1 text-sm font-extrabold text-slate-800"><%= settings.security.fingerprint ? 'Tersedia' : 'Tidak' %></p>
              <p class="text-[10px] font-semibold text-slate-500">Akses penghuni</p>
            </div>
            <div class="col-span-2 rounded-xl bg-slate-50 p-3.5">
              <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Akses Gerbang</p>
              <p class="mt-1 text-xs font-bold text-slate-800"><%= settings.security.gate_hours %></p>
            </div>
            <div class="col-span-2 rounded-xl bg-slate-50 p-3.5">
              <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Patroli</p>
              <p class="mt-1 text-xs font-bold text-slate-800"><%= settings.security.patrol %></p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-sky-50 text-sky-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg></span>
            <div><h2 class="text-base font-extrabold text-slate-900">Akses Lokasi</h2><p class="text-xs text-slate-500">Jarak dari gerbang utama kos.</p></div>
          </div>
          <div class="mt-5 space-y-2.5">
            <% settings.locations.forEach((location) => {
              const accessText = location.access || [location.distance, location.travel_time].filter(Boolean).join(' - ');
            %>
              <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-3.5 py-3">
                <span class="h-2 w-2 shrink-0 rounded-full bg-brand-500"></span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-xs font-bold text-slate-800"><%= location.name %> <span class="font-medium text-slate-400">· <%= location.category %></span></p>
                  <p class="text-[10px] text-slate-500"><%= accessText %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/end') %>
