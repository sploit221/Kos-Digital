<%- include('../partials/head', { title: 'Dashboard Penghuni', bodyClass: 'bg-slate-100 text-slate-800' }) %>
<div class="min-h-screen">
  <%- include('../partials/penghuni-sidebar') %>
  <div class="lg:pl-72">
    <%- include('../partials/dash-topbar', { title: 'Dashboard', subtitle: greeting() + ', ' + currentUser.name + '. Selamat datang di Kos Digital.' }) %>

    <main class="space-y-6 p-4 sm:p-6 lg:p-8">
      <%- include('../partials/flash') %>

      <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-600 via-emerald-600 to-teal-700 p-6 text-white shadow-glow sm:p-8">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
        <div class="absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-emerald-300/20 blur-2xl"></div>
        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-100">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-300 animate-pulse-soft"></span> Penghuni Aktif
            </span>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl"><%= greeting() %>, <%= currentUser.name.split(' ')[0] %>!</h2>
            <p class="mt-2 max-w-lg text-sm leading-relaxed text-emerald-50/90">Gunakan menu di samping untuk melaporkan kerusakan fasilitas dan melihat peraturan kos. Pantau status laporan Anda secara real-time.</p>
            <div class="mt-5 flex flex-wrap gap-2.5">
              <a href="/penghuni/maintenance" class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-xs font-bold text-emerald-700 shadow-lg transition hover:bg-emerald-50">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M14.5 6.5a4 4 0 0 0-5-5L7 4l3 3 2.5-2.5a4 4 0 0 0 2 2ZM9.5 7.5 3 14v4h4l6.5-6.5M13 20l7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Lapor Kerusakan
              </a>
              <a href="/penghuni/rules" class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-4 py-2.5 text-xs font-bold text-white backdrop-blur transition hover:bg-white/20">
                Lihat Peraturan
              </a>
            </div>
          </div>

          <div class="w-full max-w-xs rounded-2xl border border-white/20 bg-white/10 p-5 backdrop-blur">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-100">Kamar Anda</p>
            <div class="mt-2 flex items-end gap-2">
              <span class="text-5xl font-extrabold leading-none tracking-tight"><%= currentUser.room_number || '-' %></span>
              <span class="pb-1 text-xs font-semibold text-emerald-100"><%= currentUser.room_type || 'Standard' %></span>
            </div>
            <div class="mt-4 space-y-2 border-t border-white/20 pt-3 text-[11px]">
              <div class="flex items-center justify-between"><span class="text-emerald-100">Sewa bulanan</span><span class="font-bold"><%= formatRupiah(currentUser.monthly_price) %></span></div>
              <div class="flex items-center justify-between"><span class="text-emerald-100">Status laporan</span><span class="font-bold"><%= stats.pending + stats.diproses %> aktif</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <a href="/penghuni/maintenance" class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-amber-600">Pending</p>
          <p class="mt-1.5 text-2xl font-extrabold text-amber-800"><%= stats.pending %></p>
        </a>
        <a href="/penghuni/maintenance" class="rounded-2xl border border-sky-200 bg-sky-50 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-sky-600">Diproses</p>
          <p class="mt-1.5 text-2xl font-extrabold text-sky-800"><%= stats.diproses %></p>
        </a>
        <a href="/penghuni/maintenance" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-600">Selesai</p>
          <p class="mt-1.5 text-2xl font-extrabold text-emerald-800"><%= stats.selesai %></p>
        </a>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Total Laporan</p>
          <p class="mt-1.5 text-2xl font-extrabold text-slate-900"><%= stats.total %></p>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
          <div class="flex items-center justify-between border-b border-slate-100 p-5 sm:p-6">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Laporan Terbaru</h2>
              <p class="mt-0.5 text-xs text-slate-500">Status penanganan laporan kerusakan Anda.</p>
            </div>
            <a href="/penghuni/maintenance" class="rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">Semua</a>
          </div>

          <% if (recentReports.length === 0) { %>
            <div class="p-8 text-center">
              <span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-emerald-50 text-emerald-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <p class="mt-4 text-sm font-semibold text-slate-600">Belum ada laporan kerusakan.</p>
              <p class="mt-1 text-xs text-slate-400">Semua fasilitas dalam kondisi baik. Terima kasih!</p>
              <a href="/penghuni/maintenance" class="mt-4 inline-flex rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-bold text-white transition hover:bg-brand-700">Buat Laporan</a>
            </div>
          <% } else { %>
            <div class="divide-y divide-slate-100">
              <% recentReports.forEach((report) => { %>
                <div class="flex items-start gap-3 p-5 sm:px-6">
                  <span class="mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-xl <%= report.status === 'selesai' ? 'bg-emerald-50 text-emerald-700' : report.status === 'diproses' ? 'bg-sky-50 text-sky-700' : 'bg-amber-50 text-amber-700' %>">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M14.5 6.5a4 4 0 0 0-5-5L7 4l3 3 2.5-2.5a4 4 0 0 0 2 2ZM9.5 7.5 3 14v4h4l6.5-6.5M13 20l7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-xs font-extrabold text-slate-900"><%= report.title %></h3>
                      <span class="rounded-full px-2 py-0.5 text-[9px] font-bold <%= badgeClass(report.status) %>"><%= statusLabel(report.status) %></span>
                    </div>
                    <p class="mt-0.5 text-[11px] text-slate-500"><%= report.category %> &middot; <%= formatDateTime(report.created_at) %></p>
                    <% if (report.admin_note) { %>
                      <p class="mt-2 rounded-lg bg-slate-50 px-2.5 py-2 text-[11px] text-slate-600"><b class="text-slate-700">Catatan admin:</b> <%= report.admin_note %></p>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-extrabold text-slate-900">Ketentuan Penting</h2>
            <div class="mt-4 space-y-3">
              <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white text-brand-700 ring-1 ring-slate-200"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                <div><p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Jam Kunjungan Tamu</p><p class="text-xs font-bold text-slate-800"><%= rulesNote.visitor_hours %></p></div>
              </div>
              <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white text-amber-700 ring-1 ring-slate-200"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 8v4m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                <div><p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Denda Keterlambatan</p><p class="text-xs font-bold text-slate-800"><%= rulesNote.late_penalty %></p></div>
              </div>
              <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white text-slate-700 ring-1 ring-slate-200"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 3 4.5 6v5.5c0 4.4 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5.1 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.7"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <div><p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Keamanan</p><p class="text-xs font-bold text-slate-800"><%= security.cctv_active ? 'CCTV Aktif' : 'CCTV Off' %> &middot; <%= security.fingerprint ? 'Fingerprint' : 'Kunci' %></p></div>
              </div>
            </div>
            <a href="/penghuni/rules" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">Baca Semua Peraturan</a>
          </div>

          <div class="rounded-2xl bg-slate-950 p-5 text-white shadow-soft">
            <h2 class="text-sm font-extrabold">Butuh bantuan?</h2>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-400">Hubungi pengelola kos untuk pertanyaan seputar kamar, pembayaran, atau fasilitas.</p>
            <% const contactNumber = profile.whatsapp || profile.phone || ''; %>
            <p class="mt-3 text-xs font-bold text-white"><%= profile.manager || 'Pengelola Kos' %></p>
            <p class="mt-1 rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-emerald-300"><%= contactNumber || 'Nomor kontak belum diatur oleh pengelola.' %></p>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/end') %>
