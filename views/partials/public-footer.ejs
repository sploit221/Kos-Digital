<%
const profileContact = settings.profile.whatsapp || settings.profile.phone || '';
const profileWa = String(profileContact).replace(/\D/g, '');
%>
<footer class="bg-slate-950 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <%- include('logo', { light: true }) %>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-slate-400">
          <%= settings.profile.tagline || 'Hunian nyaman, aman, dan terhubung digital.' %>
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-semibold">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1.5 text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> PWA Ready
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-slate-300">
            <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span> Data SQLite
          </span>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Navigasi</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="#kamar" class="transition hover:text-emerald-300">Ketersediaan Kamar</a></li>
          <li><a href="#fasilitas" class="transition hover:text-emerald-300">Fasilitas</a></li>
          <li><a href="#keamanan" class="transition hover:text-emerald-300">Keamanan</a></li>
          <li><a href="#aturan" class="transition hover:text-emerald-300">Peraturan</a></li>
          <li><a href="/login" class="transition hover:text-emerald-300">Masuk Penghuni / Admin</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Kontak</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
            <span><%= settings.profile.address || '-' %></span>
          </li>
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l1.5 4-2 1.5a12 12 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3 6.2 2 2 0 0 1 5 4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            <% if (profileContact) { %>
              <a href="<%= profileWa ? 'https://wa.me/' + profileWa : 'tel:' + profileContact %>" target="_blank" rel="noopener noreferrer" class="transition hover:text-emerald-300"><%= profileContact %></a>
            <% } else { %>
              <span>Nomor kontak belum diatur</span>
            <% } %>
          </li>
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.7"/><path d="m4.5 7 7.5 6 7.5-6" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            <span>Pengelola: <%= settings.profile.manager || 'Belum diatur' %></span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-slate-800 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; <%= currentYear %> Kos Digital. Seluruh hak cipta dilindungi.</p>
      <p>Dibangun dengan Express, SQLite, dan Tailwind CSS.</p>
    </div>
  </div>
</footer>
