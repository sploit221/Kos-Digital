<header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/80 backdrop-blur-xl">
  <div class="flex min-h-20 items-center gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <button id="sidebarToggle" type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white p-2.5 text-slate-700 shadow-sm lg:hidden" aria-label="Buka menu">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>

    <div class="min-w-0">
      <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-600"><%= currentUser.role === 'admin' ? 'Panel Admin' : 'Panel Penghuni' %></p>
      <h1 class="truncate text-lg font-extrabold tracking-tight text-slate-900 sm:text-xl"><%= title %></h1>
      <% if (typeof subtitle !== 'undefined' && subtitle) { %>
        <p class="mt-0.5 hidden truncate text-xs text-slate-500 sm:block"><%= subtitle %></p>
      <% } %>
    </div>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <button id="installApp" type="button" class="hidden items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 shadow-sm transition hover:border-brand-300 hover:text-brand-700">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="hidden sm:inline">Instal Aplikasi</span>
      </button>

      <div class="hidden items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm md:flex">
        <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 9h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <span class="text-[11px] font-semibold text-slate-500"><%= formatDate(new Date()) %></span>
      </div>

      <div class="hidden items-center gap-2.5 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 shadow-sm sm:flex">
        <div class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-emerald-400 to-teal-600 text-[11px] font-extrabold text-white">
          <%= initials(currentUser.name) %>
        </div>
        <div class="pr-1">
          <p class="max-w-[120px] truncate text-xs font-bold text-slate-800"><%= currentUser.name %></p>
          <p class="text-[10px] font-medium capitalize text-slate-400"><%= currentUser.role %></p>
        </div>
      </div>
    </div>
  </div>
</header>
