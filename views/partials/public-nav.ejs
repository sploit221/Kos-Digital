<header id="publicNav" class="fixed inset-x-0 top-0 z-40 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-3 flex items-center justify-between gap-3 rounded-2xl border border-white/70 bg-white/85 px-4 py-3 shadow-soft backdrop-blur-xl">
      <a href="/" class="rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2">
        <%- include('logo') %>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi utama">
        <a href="#kamar" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">Kamar</a>
        <a href="#fasilitas" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">Fasilitas</a>
        <a href="#lokasi" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">Lokasi</a>
        <a href="#keamanan" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">Keamanan</a>
        <a href="#aturan" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">Aturan</a>
      </nav>

      <div class="hidden items-center gap-2 lg:flex">
        <button id="installApp" type="button" class="hidden items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Instal
        </button>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="<%= currentUser.role === 'admin' ? '/admin' : '/penghuni' %>" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-slate-800">
            Dashboard
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        <% } else { %>
          <a href="/login" class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 transition hover:bg-slate-100">Masuk</a>
          <a href="#kamar" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700">
            Cek Kamar
          </a>
        <% } %>
      </div>

      <button id="menuToggle" type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-200 p-2 text-slate-700 lg:hidden" aria-label="Buka menu" aria-expanded="false" aria-controls="mobileMenu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div id="mobileMenu" class="mt-2 hidden rounded-2xl border border-white/70 bg-white/95 p-3 shadow-soft backdrop-blur-xl lg:hidden">
      <nav class="grid gap-1 text-sm font-semibold text-slate-600" aria-label="Navigasi seluler">
        <a href="#kamar" class="rounded-xl px-3 py-2.5 hover:bg-slate-100">Ketersediaan Kamar</a>
        <a href="#fasilitas" class="rounded-xl px-3 py-2.5 hover:bg-slate-100">Fasilitas</a>
        <a href="#lokasi" class="rounded-xl px-3 py-2.5 hover:bg-slate-100">Akses Lokasi</a>
        <a href="#keamanan" class="rounded-xl px-3 py-2.5 hover:bg-slate-100">Keamanan</a>
        <a href="#aturan" class="rounded-xl px-3 py-2.5 hover:bg-slate-100">Peraturan</a>
      </nav>
      <div class="mt-3 grid gap-2 border-t border-slate-100 pt-3">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="<%= currentUser.role === 'admin' ? '/admin' : '/penghuni' %>" class="rounded-xl bg-slate-900 px-4 py-3 text-center text-sm font-bold text-white">Buka Dashboard</a>
        <% } else { %>
          <a href="/login" class="rounded-xl bg-brand-600 px-4 py-3 text-center text-sm font-bold text-white">Masuk ke Akun</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
