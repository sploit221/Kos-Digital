<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title ? title + ' • Kos Digital' : 'Kos Digital' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'Kos Digital - hunian nyaman, aman, dan terhubung digital.' %>">
  <meta name="theme-color" content="#059669">
  <meta name="application-name" content="Kos Digital">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Kos Digital">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'ui-sans-serif', 'system-ui', 'sans-serif']
          },
          colors: {
            brand: {
              50: '#ecfdf5', 100: '#d1fae5', 200: '#a7f3d0', 300: '#6ee7b7',
              400: '#34d399', 500: '#10b981', 600: '#059669', 700: '#047857',
              800: '#065f46', 900: '#064e3b', 950: '#022c22'
            }
          },
          boxShadow: {
            soft: '0 18px 40px -20px rgba(15, 23, 42, 0.25)',
            glow: '0 24px 60px -24px rgba(5, 150, 105, 0.55)'
          },
          keyframes: {
            fadeUp: {
              '0%': { opacity: '0', transform: 'translateY(14px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            },
            pulseSoft: {
              '0%, 100%': { opacity: '1' },
              '50%': { opacity: '.45' }
            }
          },
          animation: {
            'fade-up': 'fadeUp .55s cubic-bezier(.22,1,.36,1) both',
            'pulse-soft': 'pulseSoft 2.2s ease-in-out infinite'
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : 'bg-slate-50 text-slate-800' %> antialiased">
