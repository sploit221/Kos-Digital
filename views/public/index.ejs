<%- include('../partials/head', { title: 'Beranda', bodyClass: 'bg-slate-50 text-slate-800', description: settings.profile.description }) %>
<%- include('../partials/public-nav') %>

<%
const facilityIcons = [
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M5 12.5a7 7 0 0 1 14 0M8.5 15.5a3.5 3.5 0 0 1 7 0M12 19h.01M2.5 9.5C4.8 6.5 8.2 4.8 12 4.8s7.2 1.7 9.5 4.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M4.9 6.5l14.2 11M19.1 6.5 4.9 17.5M8 4.2l4 3.6 4-3.6M8 19.8l4-3.6 4 3.6M3.2 10l5.4.6.6-5.4M20.8 10l-5.4.6-.6-5.4M3.2 14l5.4-.6.6 5.4M20.8 14l-5.4-.6-.6 5.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3ZM6 12V6a2 2 0 0 1 2-2h1M12 12V5.5a2 2 0 0 1 2-2h1M7 19l-1 2M17 19l1 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M5 10h14v6a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4v-6ZM5 10l1.5-5h11L19 10M4 10h16M9 3v2M15 3v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="3" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="13" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M8 6h.01M16 6h.01M12 13l2 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M4 16v3m16-3v3M3 16l1.3-5.2A2 2 0 0 1 6.2 9h11.6a2 2 0 0 1 1.9 1.8L21 16H3ZM6 9V6.5A1.5 1.5 0 0 1 7.5 5h9A1.5 1.5 0 0 1 18 6.5V9M7 13h.01M17 13h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 6.5C10.6 5.4 8.8 4.8 7 4.8c-1.4 0-2.7.3-3.8.9v13.6c1.1-.6 2.4-.9 3.8-.9 1.8 0 3.6.6 5 1.7 1.4-1.1 3.2-1.7 5-1.7 1.4 0 2.7.3 3.8.9V5.7c-1.1-.6-2.4-.9-3.8-.9-1.8 0-3.6.6-5 1.7ZM12 6.5v13.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M7 3.5h10l-1.2 5.2A4.2 4.2 0 0 1 11.7 12h-.4a4.2 4.2 0 0 1-4.1-3.3L6 3.5h1ZM12 12v6M8 21h8M9 21v-2.5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2V21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'
];
const contactNumber = settings.profile.whatsapp || settings.profile.phone || '';
const waNumber = String(contactNumber).replace(/\D/g, '');
const managerName = settings.profile.manager || 'Pengelola Kos';
const occupancy = summary.rooms.total ? Math.round((summary.rooms.terisi / summary.rooms.total) * 100) : 0;
const available = summary.rooms.kosong || 0;
const hasRoomData = summary.rooms.total > 0;
%>

<main>
  <section class="relative overflow-hidden bg-slate-950 pt-32 pb-20 lg:pt-40 lg:pb-28">
    <div class="absolute inset-0 hero-grid"></div>
    <div class="absolute -left-24 top-24 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
    <div class="absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-teal-400/10 blur-3xl"></div>
    <div class="absolute left-1/2 top-0 h-64 w-[40rem] -translate-x-1/2 rounded-full bg-emerald-400/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div class="animate-fade-up">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-soft"></span>
            <%= settings.profile.name || 'Kos Digital' %>
          </span>
          <h1 class="mt-6 max-w-2xl text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Hunian nyaman,<br class="hidden sm:block">
            <span class="bg-gradient-to-r from-emerald-300 via-emerald-400 to-teal-300 bg-clip-text text-transparent">aman &amp; transparan.</span>
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">
            <%= settings.profile.description %>
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#kamar" class="inline-flex items-center gap-2 rounded-2xl bg-emerald-500 px-5 py-3.5 text-sm font-bold text-white shadow-glow transition hover:bg-emerald-400">
              Cek Ketersediaan
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#fasilitas" class="inline-flex items-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-5 py-3.5 text-sm font-bold text-white backdrop-blur transition hover:border-white/30 hover:bg-white/10">
              Lihat Fasilitas
            </a>
            <button type="button" data-install-app class="hidden items-center gap-2 rounded-2xl border border-emerald-400/30 bg-emerald-400/10 px-5 py-3.5 text-sm font-bold text-emerald-300 transition hover:bg-emerald-400/20">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Instal Aplikasi
            </button>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-xs font-semibold text-slate-400">
            <span class="inline-flex items-center gap-2">
              <span class="grid h-7 w-7 place-items-center rounded-lg bg-white/5 text-emerald-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m16 10 5-3v10l-5-3" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
              CCTV <%= settings.security.cctv_active ? 'Aktif 24 Jam' : 'Terpantau' %>
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="grid h-7 w-7 place-items-center rounded-lg bg-white/5 text-emerald-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M6 11V8a6 6 0 0 1 12 0v3M5 11h14v9H5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <%= settings.security.fingerprint ? 'Akses Fingerprint' : 'Akses Terkunci' %>
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="grid h-7 w-7 place-items-center rounded-lg bg-white/5 text-emerald-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M5 12.5a7 7 0 0 1 14 0M8.5 15.5a3.5 3.5 0 0 1 7 0M12 19h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
              WiFi Cepat
            </span>
          </div>
        </div>

        <div class="animate-fade-up lg:justify-self-end" style="animation-delay: 120ms;">
          <div class="relative w-full max-w-md rounded-[2rem] border border-white/60 bg-white/95 p-6 shadow-2xl backdrop-blur sm:p-8">
            <div class="absolute -right-3 -top-3 rounded-full bg-emerald-500 px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-lg shadow-emerald-500/30">
              Live
            </div>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">Status Ketersediaan</p>
                <h2 class="mt-1 text-lg font-extrabold tracking-tight text-slate-900">Kamar Kos</h2>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse-soft"></span> Real-time
              </span>
            </div>

            <div data-availability-empty class="<%= hasRoomData ? 'hidden' : '' %> mt-7 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-5 text-center">
              <p class="text-sm font-semibold text-slate-600">Belum ada data ketersediaan.</p>
              <p class="mt-1 text-xs text-slate-400">Pengelola belum menambahkan data kamar.</p>
            </div>

            <div data-availability-content class="<%= hasRoomData ? '' : 'hidden' %>">
            <div class="mt-7 flex items-end gap-2">
              <span data-stat="kosong" class="text-6xl font-extrabold leading-none tracking-tighter text-slate-900"><%= summary.rooms.kosong %></span>
              <span class="pb-1.5 text-sm font-semibold text-slate-500">kamar tersedia</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">dari <span data-stat="total" class="font-bold text-slate-700"><%= summary.rooms.total %></span> kamar terdaftar</p>

            <div class="mt-6">
              <div class="flex items-center justify-between text-[11px] font-semibold">
                <span class="text-slate-500">Tingkat hunian</span>
                <span class="text-slate-800"><span id="occupancyPercent"><%= occupancy %></span>%</span>
              </div>
              <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-100">
                <div id="occupancyBar" class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-teal-500 transition-all duration-700" style="width: <%= occupancy %>%"></div>
              </div>
              <div class="mt-2 flex items-center justify-between text-[11px] text-slate-500">
                <span>Terisi <b data-stat="terisi" class="text-slate-700"><%= summary.rooms.terisi %></b></span>
                <span>Maintenance <b data-stat="maintenance" class="text-slate-700"><%= summary.rooms.maintenance %></b></span>
              </div>
            </div>

            <div class="mt-6 grid grid-cols-2 gap-3">
              <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                <div class="flex items-center gap-2 text-slate-500">
                  <svg class="h-4 w-4 text-emerald-600" viewBox="0 0 24 24" fill="none"><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3ZM6 12V6a2 2 0 0 1 2-2h1M12 12V5.5a2 2 0 0 1 2-2h1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                  <span class="text-[10px] font-bold uppercase tracking-wider">Fasilitas</span>
                </div>
                <p class="mt-1.5 text-2xl font-extrabold text-slate-900"><%= settings.facilities.length %><span class="ml-1 text-xs font-semibold text-slate-400">item</span></p>
              </div>
              <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                <div class="flex items-center gap-2 text-slate-500">
                  <svg class="h-4 w-4 text-emerald-600" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
                  <span class="text-[10px] font-bold uppercase tracking-wider">Lokasi</span>
                </div>
                <p class="mt-1.5 text-2xl font-extrabold text-slate-900"><%= settings.locations.length %><span class="ml-1 text-xs font-semibold text-slate-400">akses</span></p>
              </div>
            </div>

            <div class="mt-5 flex items-center gap-2 rounded-2xl bg-emerald-50 px-3.5 py-2.5 text-[11px] font-semibold text-emerald-800">
              <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500 animate-pulse-soft"></span>
              Data langsung dari database &middot; <span id="lastUpdated" class="font-bold">baru saja</span>
            </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="kamar" class="relative -mt-10 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-soft sm:p-8 lg:p-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-brand-700 ring-1 ring-inset ring-brand-600/15">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span> Ketersediaan Kamar
            </span>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Pilih tipe kamar yang sesuai</h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500">Jumlah kamar diperbarui otomatis setiap 10 detik dari database. Hubungi pengelola untuk proses survei dan pemesanan.</p>
          </div>
          <div class="inline-flex items-center gap-2 self-start rounded-xl bg-slate-50 px-3 py-2 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-200 sm:self-auto">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse-soft"></span>
            <span id="typeLiveText"><%= hasRoomData ? available + ' kamar kosong' : 'Belum ada data ketersediaan' %></span>
          </div>
        </div>

        <div data-type-empty class="<%= summary.types.length === 0 ? '' : 'hidden' %> mt-8 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
          <p class="text-sm font-semibold text-slate-600">Belum ada data ketersediaan.</p>
          <p class="mt-1 text-xs text-slate-400">Tipe kamar akan tampil di sini setelah pengelola menambahkan data kamar.</p>
        </div>

        <div data-type-grid class="<%= summary.types.length === 0 ? 'hidden' : '' %> mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% summary.types.forEach((type) => { %>
            <div data-type-card data-room-type="<%= type.room_type %>" class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-gradient-to-b from-white to-slate-50 p-5 transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-soft">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Tipe Kamar</p>
                  <h3 class="mt-1 text-lg font-extrabold text-slate-900"><%= type.room_type %></h3>
                </div>
                <span data-type-status class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-bold <%= type.available > 0 ? 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20' : 'bg-rose-50 text-rose-700 ring-1 ring-inset ring-rose-600/20' %>">
                  <span class="h-1.5 w-1.5 rounded-full <%= type.available > 0 ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                  <%= type.available > 0 ? 'Tersedia' : 'Penuh' %>
                </span>
              </div>
              <div class="mt-5 flex items-end gap-1.5">
                <span class="js-type-available text-4xl font-extrabold leading-none tracking-tight text-slate-900"><%= type.available %></span>
                <span class="pb-1 text-xs font-semibold text-slate-500">/ <span class="js-type-total"><%= type.total %></span> kamar</span>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Mulai dari</p>
                  <p class="text-sm font-extrabold text-slate-800"><%= formatRupiah(type.min_price) %><span class="text-[10px] font-semibold text-slate-400">/bln</span></p>
                </div>
                <a href="#kontak" class="inline-flex items-center gap-1 text-xs font-bold text-brand-700 transition group-hover:gap-2">
                  Tanya
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="mt-6 flex flex-col gap-3 rounded-2xl border border-emerald-100 bg-emerald-50/70 px-4 py-3.5 text-xs font-semibold text-emerald-800 sm:flex-row sm:items-center sm:justify-between">
          <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            Data ketersediaan dapat berubah sewaktu-waktu. Konfirmasi terakhir dengan pengelola.
          </span>
          <a href="#kontak" class="inline-flex items-center gap-1.5 font-bold text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:text-emerald-900">Hubungi pengelola</a>
        </div>
      </div>
    </div>
  </section>

  <section id="fasilitas" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-600">Fasilitas Kos</span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Semua yang Anda butuhkan, sudah tersedia</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">Fasilitas bersama maupun pribadi dirancang untuk mendukung produktivitas dan kenyamanan penghuni.</p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <% settings.facilities.forEach((facility, index) => { %>
          <div class="group rounded-2xl border border-slate-200 bg-slate-50/60 p-5 transition hover:-translate-y-0.5 hover:border-emerald-200 hover:bg-white hover:shadow-soft">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-white text-brand-600 shadow-sm ring-1 ring-slate-200 transition group-hover:bg-brand-600 group-hover:text-white group-hover:ring-brand-600">
              <span class="h-5 w-5"><%- facilityIcons[index % facilityIcons.length] %></span>
            </div>
            <h3 class="mt-4 text-sm font-extrabold text-slate-900"><%= facility.name %></h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-500"><%= facility.description || 'Tersedia untuk seluruh penghuni.' %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <section id="lokasi" class="relative overflow-hidden bg-slate-50 py-20">
    <div class="absolute inset-0 dot-grid opacity-60"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-600 ring-1 ring-slate-200">Akses Lokasi &amp; Tempat Terdekat</span>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Dekat dengan pusat perbelanjaan, pelabuhan, dan kampus di Batam Center</h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-500">Lokasi strategis dengan akses mudah ke berbagai tempat populer. Semua estimasi waktu diukur dari gerbang utama kos.</p>
        </div>
        <div class="inline-flex w-fit items-center gap-3 rounded-2xl bg-white px-4 py-3 text-xs font-bold text-slate-600 shadow-sm ring-1 ring-slate-200">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-50 text-brand-700">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
          </span>
          <span><%= settings.locations.length %> tempat strategis</span>
        </div>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <% settings.locations.forEach((location, index) => {
          const accessText = location.access || [location.distance, location.travel_time].filter(Boolean).join(' - ');
          const mapsUrl = location.maps_url || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.name + ' Batam')}`;
          const photoUrl = location.photo_url || '';
        %>
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-emerald-200 hover:shadow-soft">
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-900">
              <div class="absolute inset-0 bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900"></div>
              <div class="absolute inset-0 grid place-items-center p-5 text-center">
                <div>
                  <span class="mx-auto grid h-11 w-11 place-items-center rounded-2xl bg-white/10 text-white ring-1 ring-inset ring-white/20">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
                  </span>
                  <p class="mt-2 text-[11px] font-bold leading-snug text-white"><%= location.name %></p>
                  <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-wider text-emerald-100/70">Foto referensi</p>
                </div>
              </div>
              <% if (photoUrl) { %>
                <img src="<%= photoUrl %>" alt="Foto <%= location.name %>" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" onerror="this.classList.add('hidden')">
              <% } %>
              <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-2 p-3">
                <span class="rounded-full bg-white/95 px-2.5 py-1 text-[9px] font-extrabold uppercase tracking-wider text-slate-700 shadow-sm backdrop-blur"><%= location.category %></span>
                <span class="grid h-7 w-7 place-items-center rounded-full bg-slate-950/60 text-[10px] font-extrabold text-white backdrop-blur"><%= String(index + 1).padStart(2, '0') %></span>
              </div>
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-slate-950/70 to-transparent"></div>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-base font-extrabold leading-snug text-slate-900"><%= location.name %></h3>
              <p class="mt-2 flex-1 text-xs leading-relaxed text-slate-500"><%= accessText %></p>
              <a href="<%= mapsUrl %>" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-bold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
                Buka di Google Maps
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </article>
        <% }); %>
      </div>

      <p class="mt-6 text-center text-[11px] font-medium text-slate-400">Estimasi waktu dihitung dari gerbang utama kos. Foto bersumber dari referensi publik masing-masing tempat.</p>
    </div>
  </section>

  <section id="keamanan" class="bg-slate-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-soft"></span> Keamanan Lingkungan
          </span>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Tenang tinggal, keamanan terpantau sepanjang hari</h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-400"><%= settings.security.notes %></p>

          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center gap-2 text-slate-400">
                <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m16 10 5-3v10l-5-3" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span class="text-[10px] font-bold uppercase tracking-wider">CCTV</span>
              </div>
              <p class="mt-2 text-lg font-extrabold text-white"><%= settings.security.cctv_count || 0 %> Titik</p>
              <p class="mt-0.5 text-[11px] font-semibold <%= settings.security.cctv_active ? 'text-emerald-400' : 'text-amber-400' %>"><%= settings.security.cctv_active ? 'Aktif 24 jam' : 'Dalam perawatan' %></p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center gap-2 text-slate-400">
                <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 24 24" fill="none"><path d="M6 11V8a6 6 0 0 1 12 0v3M5 11h14v9H5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="text-[10px] font-bold uppercase tracking-wider">Akses Pintu</span>
              </div>
              <p class="mt-2 text-lg font-extrabold text-white"><%= settings.security.fingerprint ? 'Fingerprint' : 'Kunci Digital' %></p>
              <p class="mt-0.5 text-[11px] font-semibold <%= settings.security.fingerprint ? 'text-emerald-400' : 'text-slate-400' %>"><%= settings.security.fingerprint ? 'Verifikasi sidik jari' : 'Akses terkontrol' %></p>
            </div>
          </div>

          <div class="mt-4 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-emerald-400/10 text-emerald-300">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </span>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Jam Akses Gerbang</p>
              <p class="mt-0.5 text-xs font-semibold text-white"><%= settings.security.gate_hours %></p>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/10 to-white/[0.02] p-6 backdrop-blur sm:p-8">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">Status Keamanan</p>
              <h3 class="mt-1 text-xl font-extrabold text-white">Monitoring Aktif</h3>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-emerald-300">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse-soft"></span> Online
            </span>
          </div>

          <div class="mt-7 space-y-3">
            <div class="flex items-center gap-4 rounded-2xl bg-slate-950/50 p-4 ring-1 ring-inset ring-white/5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-emerald-500/15 text-emerald-300">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m16 10 5-3v10l-5-3" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-white">CCTV Area Bersama</p>
                <p class="text-[11px] text-slate-400">Koridor, parkir, gerbang, dan ruang tamu</p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[10px] font-bold text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> <%= settings.security.cctv_active ? 'Aktif' : 'Off' %></span>
            </div>

            <div class="flex items-center gap-4 rounded-2xl bg-slate-950/50 p-4 ring-1 ring-inset ring-white/5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sky-500/15 text-sky-300">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M6 11V8a6 6 0 0 1 12 0v3M5 11h14v9H5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-white">Akses Fingerprint</p>
                <p class="text-[11px] text-slate-400">Pintu utama &amp; area privat penghuni</p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-500/10 px-2.5 py-1 text-[10px] font-bold text-sky-300"><span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span> <%= settings.security.fingerprint ? 'Aktif' : 'Off' %></span>
            </div>

            <div class="flex items-center gap-4 rounded-2xl bg-slate-950/50 p-4 ring-1 ring-inset ring-white/5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-amber-500/15 text-amber-300">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 3 4.5 6v5.5c0 4.4 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5.1 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-white">Patroli Petugas</p>
                <p class="text-[11px] text-slate-400"><%= settings.security.patrol %></p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[10px] font-bold text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Rutin</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="aturan" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-600">Peraturan &amp; Tata Tertib</span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Kenyamanan bersama dimulai dari aturan yang jelas</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">Aturan resmi berlaku untuk seluruh penghuni dan tamu. Pelanggaran dapat dikenakan sanksi sesuai ketentuan pengelola.</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[1.4fr_0.6fr]">
        <div class="grid gap-3 sm:grid-cols-2">
          <% settings.rules.forEach((rule, index) => { %>
            <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-5 transition hover:border-emerald-200 hover:bg-white">
              <div class="flex items-center gap-3">
                <span class="grid h-8 w-8 place-items-center rounded-lg bg-white text-xs font-extrabold text-brand-700 shadow-sm ring-1 ring-slate-200"><%= String(index + 1).padStart(2, '0') %></span>
                <h3 class="text-sm font-extrabold text-slate-900"><%= rule.title %></h3>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-slate-500"><%= rule.description %></p>
            </div>
          <% }); %>
        </div>

        <aside class="space-y-4">
          <div class="rounded-2xl bg-slate-950 p-6 text-white shadow-soft">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">Ringkasan Ketentuan</p>
            <div class="mt-5 space-y-4">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-300">Jam Kunjungan Tamu</p>
                <p class="mt-1 text-sm font-extrabold"><%= settings.rules_note.visitor_hours %></p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-300">Batas Jam Malam</p>
                <p class="mt-1 text-sm font-extrabold"><%= settings.rules_note.curfew %></p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-300">Denda Keterlambatan Sewa</p>
                <p class="mt-1 text-sm font-extrabold"><%= settings.rules_note.late_penalty %></p>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-300">Denda Kerusakan</p>
                <p class="mt-1 text-sm font-extrabold"><%= settings.rules_note.damage_penalty %></p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">Butuh bantuan?</p>
            <p class="mt-2 text-sm font-extrabold text-slate-900"><%= managerName %></p>
            <p class="mt-1 text-xs text-slate-500"><%= contactNumber || 'Nomor kontak belum diatur oleh pengelola.' %></p>
            <% if (waNumber) { %>
              <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-bold text-white transition hover:bg-brand-700">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.2-.3.1-.5l-.8-1.8c-.1-.3-.3-.3-.4-.3h-.5c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1 0 1.3.9 2.5 1 2.7.1.2 1.7 2.7 4.2 3.7 2.1.8 2.5.7 2.9.6.4-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.2-.2-.2-.4-.3Z"/></svg>
                Hubungi via WhatsApp
              </a>
            <% } else { %>
              <span class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-500">WhatsApp belum diatur</span>
            <% } %>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section id="kontak" class="bg-slate-50 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-emerald-600 via-emerald-600 to-teal-700 p-8 shadow-glow sm:p-12">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
        <div class="absolute -bottom-24 -left-10 h-64 w-64 rounded-full bg-emerald-300/20 blur-2xl"></div>
        <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-100">Siap menjadi penghuni?</p>
            <h2 class="mt-3 max-w-2xl text-2xl font-extrabold leading-tight text-white sm:text-3xl">Jadwalkan survei dan amankan kamar pilihan Anda hari ini.</h2>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-emerald-100/90">Hubungi pengelola untuk informasi harga, ketersediaan terbaru, dan proses administrasi. Aplikasi ini juga dapat diinstal di HP Anda sebagai PWA.</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <% if (waNumber) { %>
              <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3.5 text-sm font-bold text-emerald-700 shadow-lg transition hover:bg-emerald-50">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.2-.3.1-.5l-.8-1.8c-.1-.3-.3-.3-.4-.3h-.5c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1 0 1.3.9 2.5 1 2.7.1.2 1.7 2.7 4.2 3.7 2.1.8 2.5.7 2.9.6.4-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.2-.2-.2-.4-.3Z"/></svg>
                Chat Pengelola
              </a>
            <% } else { %>
              <span class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white/80 px-5 py-3.5 text-sm font-bold text-emerald-700/70">WhatsApp belum diatur</span>
            <% } %>
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <a href="<%= currentUser.role === 'admin' ? '/admin' : '/penghuni' %>" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/30 bg-white/10 px-5 py-3.5 text-sm font-bold text-white backdrop-blur transition hover:bg-white/20">Buka Dashboard</a>
            <% } else { %>
              <a href="/login" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/30 bg-white/10 px-5 py-3.5 text-sm font-bold text-white backdrop-blur transition hover:bg-white/20">Masuk ke Akun</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/public-footer') %>
<%- include('../partials/end') %>
