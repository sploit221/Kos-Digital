<%- include('../partials/head', { title: 'Masuk', bodyClass: 'bg-slate-950 text-slate-800', description: 'Masuk ke dashboard Kos Digital.' }) %>

<main class="min-h-screen lg:grid lg:grid-cols-2">
  <section class="relative hidden overflow-hidden bg-slate-950 p-10 lg:flex lg:flex-col lg:justify-between xl:p-14">
    <div class="absolute inset-0 hero-grid"></div>
    <div class="absolute -left-24 top-1/3 h-80 w-80 rounded-full bg-emerald-500/20 blur-3xl"></div>
    <div class="absolute -right-20 bottom-10 h-72 w-72 rounded-full bg-teal-400/10 blur-3xl"></div>

    <div class="relative">
      <a href="/"><%- include('../partials/logo', { light: true }) %></a>
    </div>

    <div class="relative max-w-lg">
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-300">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-soft"></span> Portal Penghuni &amp; Admin
      </span>
      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white xl:text-5xl">
        Kelola kos dengan<br><span class="bg-gradient-to-r from-emerald-300 to-teal-300 bg-clip-text text-transparent">lebih mudah.</span>
      </h1>
      <p class="mt-5 text-sm leading-relaxed text-slate-400">Satu aplikasi untuk memantau ketersediaan kamar, mengirim laporan kerusakan, dan mengelola administrasi penghuni.</p>

      <ul class="mt-8 space-y-4">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-emerald-400/10 text-emerald-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div><p class="text-sm font-bold text-white">Data kamar real-time</p><p class="text-xs text-slate-400">Status kamar tersinkron langsung dengan database.</p></div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-emerald-400/10 text-emerald-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div><p class="text-sm font-bold text-white">Laporan maintenance</p><p class="text-xs text-slate-400">Laporkan kerusakan dan pantau status penanganan.</p></div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-emerald-400/10 text-emerald-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <div><p class="text-sm font-bold text-white">Laporan warga otomatis</p><p class="text-xs text-slate-400">Ekspor data penghuni baru untuk pihak RT.</p></div>
        </li>
      </ul>
    </div>

    <div class="relative flex items-center gap-3 text-[11px] font-medium text-slate-500">
      <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 24 24" fill="none"><path d="M12 3 4.5 6v5.5c0 4.4 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5.1 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.7"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Dilindungi JWT, bcrypt, dan Helmet.
    </div>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-10 sm:px-8">
    <div class="w-full max-w-md">
      <div class="mb-8 flex items-center justify-between lg:hidden">
        <a href="/"><%- include('../partials/logo') %></a>
        <a href="/" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 shadow-sm">Beranda</a>
      </div>

      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-soft sm:p-8">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-600">Selamat datang</p>
            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">Masuk ke akun</h2>
          </div>
          <a href="/" class="hidden items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600 transition hover:border-brand-300 hover:text-brand-700 sm:inline-flex">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="M19 12H5m0 0 5-5m-5 5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Beranda
          </a>
        </div>

        <p class="mt-2 text-sm text-slate-500">Gunakan akun yang diberikan oleh pengelola kos.</p>

        <% if (error) { %>
          <div class="mt-5 flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
            <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none"><path d="M12 8v4m0 4h.01M10.3 3.9 2.4 17.4A1.9 1.9 0 0 0 4 20.3h16a1.9 1.9 0 0 0 1.6-2.9L13.7 3.9a1.9 1.9 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <p class="font-medium"><%= error %></p>
          </div>
        <% } %>
        <%- include('../partials/flash') %>

        <form action="/login" method="post" class="mt-6 space-y-5" autocomplete="on">
          <input type="hidden" name="next" value="<%= next %>">
          <div>
            <label for="username" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-500">Username</label>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-0 grid w-11 place-items-center text-slate-400">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.7"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </span>
              <input id="username" name="username" type="text" required maxlength="32" autocomplete="username" value="<%= username %>" placeholder="Masukkan username" class="w-full rounded-xl border-slate-200 bg-slate-50 py-3 pl-11 pr-3 text-sm font-semibold text-slate-800 placeholder:font-normal placeholder:text-slate-400 focus:border-brand-500 focus:bg-white focus:ring-brand-500">
            </div>
          </div>

          <div>
            <label for="password" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-500">Password</label>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-0 grid w-11 place-items-center text-slate-400">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M6 11V8a6 6 0 0 1 12 0v3M5 11h14v9H5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <input id="password" name="password" type="password" required maxlength="128" autocomplete="current-password" placeholder="Masukkan password" class="w-full rounded-xl border-slate-200 bg-slate-50 py-3 pl-11 pr-12 text-sm font-semibold text-slate-800 placeholder:font-normal placeholder:text-slate-400 focus:border-brand-500 focus:bg-white focus:ring-brand-500">
              <button type="button" data-toggle-password="password" class="absolute inset-y-0 right-0 grid w-11 place-items-center text-slate-400 transition hover:text-slate-700" aria-label="Tampilkan password">
                <svg class="h-5 w-5" data-eye-open viewBox="0 0 24 24" fill="none"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/></svg>
                <svg class="hidden h-5 w-5" data-eye-closed viewBox="0 0 24 24" fill="none"><path d="m4 4 16 16M9.9 5.8A9.8 9.8 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3.4 4.1M6.1 7.6C3.9 9.4 2.5 12 2.5 12S6 18.5 12 18.5c1.4 0 2.7-.3 3.8-.9M10.2 10.2a2.6 2.6 0 0 0 3.6 3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>

          <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2">
            Masuk ke Dashboard
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>

        <% if (typeof showDemo !== 'undefined' && showDemo) { %>
          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Akun Admin Awal</p>
            <div class="mt-3">
              <button type="button" data-demo-user="admin" data-demo-password="admin123" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-left transition hover:border-brand-300">
                <span class="block text-xs font-extrabold text-slate-800">Admin</span>
                <span class="block text-[10px] text-slate-500">admin / admin123</span>
              </button>
            </div>
            <p class="mt-2 text-[10px] leading-relaxed text-slate-400">Akun penghuni dibuat melalui panel admin.</p>
          </div>
        <% } %>

        <p class="mt-6 text-center text-[11px] text-slate-400">
          Dengan masuk, Anda menyetujui peraturan kos yang berlaku.
        </p>
      </div>

      <p class="mt-6 text-center text-xs text-slate-500">&copy; <%= currentYear %> Kos Digital. PWA siap dipasang di perangkat Anda.</p>
    </div>
  </section>
</main>

<%- include('../partials/end') %>
